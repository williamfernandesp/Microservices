## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results - sempre ignorar
[Bb]in/
[Oo]bj/

# User-specific files (Visual Studio)
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Ignorar arquivos .user do Visual Studio
# Exceção: pasta Fcg.Payment.Proxy.User (é um projeto, não arquivo .user)
*.[Uu]ser
!Fcg.Payment.Proxy.User
!**/Fcg.Payment.Proxy.User
!**/Fcg.Payment.Proxy.User/*.cs
!**/Fcg.Payment.Proxy.User/*.csproj
!**/Fcg.Payment.Proxy.User/**/*.cs

# Visual Studio
.vs/

# Rider
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# SQLite database (importante no seu caso)
*.db
*.db-shm
*.db-wal

# ASP.NET
appsettings.Development.json

# Test results
TestResults/

# Coverage
coverage/